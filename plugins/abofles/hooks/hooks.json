{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Abo Fles (ابو فليس) is active: in coding, design or marketing work invoke the abofles skill once per session (not per task); every Agent call passes model and effort.'"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" guard"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" qgate"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" pre"
          }
        ]
      },
      {
        "matcher": "mcp__ccd_session__start_session",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" session_pre"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" receipt"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" precompact",
            "timeout": 20
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" postcompact",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" stop"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" decision"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" post"
          }
        ]
      },
      {
        "matcher": "mcp__ccd_session__start_session",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" session_post"
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" sendmsg"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" post_bash"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" edit"
          }
        ]
      },
      {
        "matcher": "mcp__ccd_turn__update_plan|mcp__ccd_turn__wrap_up|TodoWrite|TaskCreate|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" plan"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" release"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/py\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" release"
          }
        ]
      }
    ]
  }
}
