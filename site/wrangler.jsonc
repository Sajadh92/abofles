// abofles.com — static site on Cloudflare (Workers static assets, the current Cloudflare Pages).
// Deploy: python3 site/build.py && cd site && npx wrangler@4 deploy
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "abofles",
  "compatibility_date": "2026-11-19",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "abofles.com", "custom_domain": true },
    { "pattern": "www.abofles.com", "custom_domain": true }
  ]
}
